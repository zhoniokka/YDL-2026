# Скопируйте этот файл в .env и заполните своими значениями.
# Файл .env в git НЕ попадает (см. .gitignore).

GEMMA_API_KEY=
# Базовый URL OpenAI-совместимого API (без хвостового /chat/completions),
# например: https://openrouter.ai/api/v1  или  http://localhost:1234/v1
GEMMA_BASE_URL=https://llm.alem.ai/v1
# Имя модели на вашем эндпоинте (необязательно; по умолчанию gemma4)
GEMMA_MODEL=gemma4
MAILERSEND_API_KEY=
ADMIN_EMAIL=
SENDER_EMAIL=
